# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/resume_analyzer
# MongoDB Atlas (replace the placeholder below)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume_analyzer?retryWrites=true&w=majority

# ---- Authentication ----
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ---- Client ----
CLIENT_URL=http://localhost:5173

# ---- Uploads ----
MAX_RESUME_SIZE_MB=5

# ---- Seed / default admin ----
ADMIN_NAME=System Administrator
ADMIN_EMAIL=Admin@gmail.com
ADMIN_PASSWORD=Admin@1234
SEED_DEFAULT_PASSWORD=User@12345
