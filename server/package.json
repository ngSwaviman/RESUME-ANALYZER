  "private": true,
  "description": "AI Resume Screening & Job Matching System - Express + MongoDB API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
